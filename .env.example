# 企业产品知识问答系统：Windows 本地调试配置
# 使用方式：复制为 .env，填写个人凭据；.env 不提交到 GitHub。
# 本机运行 Python 服务与 BGE 模型；Docker Desktop 在本机运行基础服务，无需服务器或 SSH 隧道。
# 百炼与 MinerU 仍调用云端服务；本地调试并不等于全部离线运行。
# 模型与接口核对日期：2026-10-21；说明见 docs/CONFIGURATION.md。
# 修改本文件不会影响运行配置；修改 .env 后需要重启两个 Python 服务。
# 系统中已有的同名环境变量优先于 .env，排查配置不生效时注意这一点。

# ==================== 一、百炼大模型：需要个人 API Key ====================
# 大模型请求的基础地址。变量名沿用 OpenAI 兼容协议，实际服务商是阿里云百炼。
# 当前为北京地域共享地址，官方确认仍可用；Key、地域和业务空间必须匹配。
# 生产环境可用控制台提供的业务空间专属地址，不能直接照抄 WorkspaceId 占位符。
# 只填到 /compatible-mode/v1，不要追加 /chat/completions。
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 必填：本人百炼 API Key。文本模型、图片模型和原 MCP 客户端共用此 Key。
# 填原始 Key，不要添加 Bearer 前缀；这不是要求购买 OpenAI 服务。
OPENAI_API_KEY=

# 文本模型：用于文档主体识别、查询改写、指代解析、HyDE 和最终答案生成。
# 当前建议先用 qwen3.8-flash 做低成本联调；均衡选 qwen3.7-plus，复杂推理选 qwen3.8-max。
# 需要支持 Chat Completions、JSON Object 和流式输出；实际可调用性以账号与地域为准。
# 客户端按 LLM_PROVIDER 能力传参，百炼默认关闭思考，可配置 LLM_ENABLE_THINKING。
LLM_DEFAULT_MODEL=qwen3.8-flash

# 图片理解模型：仅在文档导入时读取图示并生成摘要，摘要与原图链接一起保留。
# 必须支持 image_url 图片输入；文本模型与视觉模型可以使用同一个多模态型号。
# 当前建议 qwen3.8-flash；复杂图表可尝试 qwen3.7-plus 或 qwen3.8-max。
# 该模型用于理解图片内容；整份 PDF 的版面解析由下一节 MinerU 完成。
VL_MODEL=qwen3.8-flash

# 生成随机性：越低通常越稳定，知识问答先用 0.1；模型支持范围需查对应文档。
# 留空使用 0.1；合法零值 0 会保留。
LLM_DEFAULT_TEMPERATURE=0.1

# M4按能力策略：默认false，保留既有请求参数，先跑冻结原链路基线再实验。
# true后仅使用对应能力的参数；能力描述只检查配置，不代表真实供应商已验证。
PROVIDER_POLICIES_ENABLED=false
# 文本/视觉请求的超时秒数(0,3600]，SDK额外重试0..3；0不被默认值覆盖。
PROVIDER_TEXT_TIMEOUT_SECONDS=60
PROVIDER_TEXT_MAX_RETRIES=2
PROVIDER_TEXT_JSON_SUPPORTED=true
# JSON对象格式不合法时额外调用次数0..3；鉴权/错误模型不按格式重试。
PROVIDER_TEXT_JSON_RETRIES=1
PROVIDER_VISION_TIMEOUT_SECONDS=120
PROVIDER_VISION_MAX_RETRIES=2
PROVIDER_VISION_JSON_SUPPORTED=false
PROVIDER_VISION_JSON_RETRIES=1
# 本机嵌入/重排同步推理仅能在返回边界检测超时，不能抢占CUDA线程。
# 嵌入桥接另有HTTP硬超时；默认不额外重试，避免重复占用本机模型。
PROVIDER_EMBEDDING_TIMEOUT_SECONDS=300
PROVIDER_EMBEDDING_MAX_RETRIES=0
PROVIDER_EMBEDDING_JSON_SUPPORTED=false
PROVIDER_EMBEDDING_JSON_RETRIES=0
PROVIDER_RERANK_TIMEOUT_SECONDS=300
PROVIDER_RERANK_MAX_RETRIES=0
PROVIDER_RERANK_JSON_SUPPORTED=false
PROVIDER_RERANK_JSON_RETRIES=0

# ==================== 二、MinerU：PDF 结构化解析 ====================
# 云端精准解析 API 基础地址，当前官方仍使用 v4。
# 代码会申请文件上传链接、上传 PDF、轮询结果，并下载含 Markdown 和图片的 ZIP。
# 这里是接口版本；解析模型版本在 node_pdf_to_md.py 中固定为 vlm，当前官方仍推荐。
# 新增的轻量 Agent API 与现有返回格式、任务流程不同，不能仅替换此地址来切换。
MINERU_BASE_URL=https://mineru.net/api/v4

# PDF 导入必填：本人 MinerU API Token，与百炼 Key 是两套独立凭据。
# 填原始 Token，不加 Bearer 前缀；仅导入纯文本 Markdown 时可留空。
MINERU_API_TOKEN=

# ==================== 三、本地 BGE 模型：无需云端 API Key ====================
# 嵌入模型目录：把产品名、文档切片和问题转换为稠密与稀疏向量，用于相似度检索。
# 当前模型已下载并验证；从项目根目录启动，保证相对路径有效。
# BGE-M3 提供本项目需要的双路向量，稠密维度为 1024。
# 改为其他模型时需同时检查编码接口、向量维度、稀疏输出，并重建知识索引。
BGE_M3_PATH=./models/bge-m3

# 原课程保留字段：配置类读取，但当前嵌入函数实际没有使用它选择模型。
# 真正生效的是上面的 BGE_M3_PATH；仅改此项不会切换模型。
BGE_M3=BAAI/bge-m3

# 嵌入推理设备：当前安装 CPU 版 PyTorch，使用 cpu。
# 以后安装匹配的 CUDA 版 PyTorch 并验证显存后，才改为 cuda:0。
BGE_DEVICE=cpu

# 嵌入半精度：0 关闭，1 开启；CPU 调试保持 0。
BGE_FP16=0

# 重排模型目录：对已召回的本地切片与联网摘要计算问题相关性，调整证据排序。
# 已下载并验证；它是打分模型，不生成最终答案，也不是向量数据库。
# 云端重排 API 或其他模型不能只通过替换目录名接入，需要适配调用接口。
BGE_RERANKER_LARGE=./models/bge-reranker-large

# 重排推理设备：当前使用 CPU；原封装传参是否支持其他设备需在切换时验证。
BGE_RERANKER_DEVICE=cpu

# 重排半精度：CPU 调试保持 0。
BGE_RERANKER_FP16=0

# ==================== 四、Milvus：产品主体与知识切片的向量索引 ====================
# 本机 Milvus 地址包含协议；连接 Docker Desktop 发布的 127.0.0.1:19530。
# 当前客户端未接入独立鉴权 Token 配置；本机 Compose 仅绑定回环地址。
MILVUS_URL=http://127.0.0.1:19530

# 存放文档切片、标题、产品名、稠密与稀疏向量的集合，首次导入时自动创建。
# 重新导入会按产品主体清理旧数据，本地调试使用专用集合。
CHUNKS_COLLECTION=product_knowledge_chunks

# 存放产品主体名称及其向量的集合，用于将用户说的型号匹配到库内标准名称。
ITEM_NAME_COLLECTION=product_knowledge_items

# ==================== 五、MongoDB：多轮对话历史 ====================
# 保存会话消息，供查询改写、指代解析与历史展示使用；不存放文档向量。
# 本机 Compose 绑定回环地址，当前不启用数据库账号认证。
MONGO_URL=mongodb://127.0.0.1:27017

# 会话数据库名称，代码使用其中的 chat_message 集合并创建会话索引。
MONGO_DB_NAME=product_knowledge_rag

# ==================== 六、MinIO：原文件与图片对象存储 ====================
# 本机 S3 API 地址只能填 主机:端口，不带 http:// 或 https://。
# 本项目发布的 API 端口为 19000；9001 为管理控制台，不能填在这里。
MINIO_ENDPOINT=127.0.0.1:19000

# Docker 发布到 Windows 的 S3 API 端口，与上面的端口一致；容器内部仍为 9000。
MINIO_API_PORT=19000

# 本机 MinIO 账号；Compose 用它创建管理员账号，Python 应用读取同一值连接。
MINIO_ACCESS_KEY=raglocal

# 本机 MinIO 密码：现有 .env 已生成随机密码，保留即可；模板占位值需要替换。
# 至少 8 个字符；创建容器后更改此值，需要同步重建容器并重启应用。
MINIO_SECRET_KEY=CHANGE_ME_LOCAL_PASSWORD

# 本项目专用存储桶。原客户端启动时会建桶并将整个桶设为匿名可读，以便浏览器配图。
# 使用项目专用测试桶，不要指向含敏感业务数据的已有桶。
MINIO_BUCKET_NAME=product-knowledge

# 图片对象的存储前缀；实际对象还会按文档名称分目录。
MINIO_IMG_DIR=images

# 上传原始文件的存储前缀；实际对象还会按日期分目录。
MINIO_PDF_DIR=pdf_files

# 连接协议意图：False 为 HTTP，True 为 HTTPS；本地保持 False。
# 注意：原 MinIO 客户端连接时硬编码 secure=False，仅改此值无法启用 HTTPS。
MINIO_SECURE=False

# ==================== 七、MCP：可选的联网补充检索 ====================
# 百炼 WebSearch MCP 的 SSE 地址，需要在自己的账号中开通服务并复制真实地址。
# 原代码通过 MCP 客户端直接调用 bailian_web_search，服务地址并非模型名称。
# 当前客户端只支持 SSE；不能直接填 Streamable HTTP 地址或 Responses API 地址。
# 原实现共用 OPENAI_API_KEY；其 Authorization 未加 Bearer，需在正式联调时核对鉴权格式。
# 可先留空验证本地知识链路；原节点仍会尝试调用并捕获异常，并非明确关闭开关。
MCP_DASHSCOPE_BASE_URL=

# ==================== 八、运行日志 ====================
# 是否向终端输出日志：True 开启，False 关闭。
LOG_CONSOLE_ENABLE=True

# 终端日志级别：DEBUG 最详细；常用 INFO，问题排查时可改 DEBUG。
LOG_CONSOLE_LEVEL=INFO

# 是否保存日志文件到项目 logs 目录：True 开启，False 关闭。
LOG_FILE_ENABLE=True

# 文件日志级别，独立于终端日志级别。
LOG_FILE_LEVEL=INFO

# 日志保留时间，7 days 表示保留 7 天，由 Loguru 定期清理。
LOG_FILE_RETENTION=7 days


# ==================== 九、M0 型号对齐基线 ====================
# 归一化检索分数，不是概率；多个高分非精确候选要求用户确认。
# 精确同名在最低候选阈值以上优先；阈值需在 M4 标注集上校准。
PRODUCT_MATCH_HIGH_SCORE=0.85
PRODUCT_MATCH_MIN_SCORE=0.6

# 大模型供应商能力：auto 按 URL 主机识别百炼，其余按通用兼容接口处理。
# 通过非标准域名代理百炼时显式填 dashscope；通用填 openai_compatible。
LLM_PROVIDER=auto
# 仅百炼能力启用时传 enable_thinking；其他供应商完全不传该专属字段。
LLM_ENABLE_THINKING=false

# M1真实集成验证专用：必须m1_test_开头的独立Mongo库，默认留空保持单元离线。
# 不得填写原业务库；测试保留现场，不自动清库。
M1_TEST_DB=

# 显式付费供应商测试开关，默认留空；只影响指定的live_provider测试。
# 设为1时显式允许live_provider测试调用真实MinerU/视觉供应商；仅新建小样
M1_LIVE_PROVIDER=
# MinerU每段物理页/字节上限，超过字节上限继续缩小，单页过大明确失败。
MINERU_SEGMENT_MAX_PAGES=50
MINERU_SEGMENT_MAX_BYTES=100000000
# 每段轮询秒数，超时保留batch供下次恢复，不重交已成功段。
MINERU_POLL_TIMEOUT=600

# M2统一API独立账本库；必须显式填写，不默认写入旧课程库。
M2_DB_NAME=
# 执行心跳租约（秒），worker需在到期前续约
RUN_LEASE_SECONDS=60
# 人工型号确认独立等待期限，不使用执行心跳判死（秒）
RUN_INPUT_WAIT_SECONDS=86400
# 尚未领取执行的运行等待期限（秒）
RUN_PENDING_SECONDS=300
# 浏览器同源地址，逗号分隔；不允许通配符，开发端口按实际填写。
API_ALLOWED_ORIGINS=http://localhost:8000
# HTTPS默认true；仅本机HTTP联调明确设置false。
API_COOKIE_SECURE=true

# M2单组织知识归属；显式设置，不自动接管课程或M1历史owner
M2_KNOWLEDGE_OWNER_ID=
# 指定已存在的知识对象桶，新功能不自动建桶或修改策略
M2_OBJECT_BUCKET=
# 新知识独立对象前缀，例如 knowledge-api-v2/；不得指向课程原件目录
M2_OBJECT_PREFIX=
# 独立v2索引集合；不得使用原CHUNKS_COLLECTION
M2_MILVUS_COLLECTION=
# 单个上传原件字节上限，multipart另允许64KiB元数据
UPLOAD_MAX_BYTES=100000000

# 导入队列；宿主使用回环，容器由compose覆盖为redis服务名
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
M2_QUEUE_NAME=knowledge-import
# worker执行租约及续约间隔（秒），心跳必须小于租约
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=10
# Linux worker持久工作目录，须对应worker-cache挂载，不填写Windows绝对路径
M2_WORK_DIR=/var/lib/knowledge-worker
# 宿主现有模型桥接，仅本机/容器使用；令牌必须自行生成，不设默认密钥
MODEL_HOST_PORT=8011
MODEL_HOST_URL=http://127.0.0.1:8011
MODEL_HOST_TOKEN=
# 图摘要全worker共享供应商预算（每分钟请求数）
VISION_REQUESTS_PER_MINUTE=30
# M3前端本机代理目标，仅Vite开发服务读取；不带凭据，不使用VITE_前缀暴露后端密钥。
API_PROXY_TARGET=http://127.0.0.1:8000

# M4正式问答检索策略JSON；空值保留dense/sparse各20、加权融合20、重排20、上下文10。
# 可选字段dense_limit/sparse_limit/fusion_limit/rerank_limit/context_limit、fusion(weighted/rrf/dense/learned_sparse)。
# 调参只用dev；不凭合成测试增大生产默认，不把learned_sparse称为BM25。
RETRIEVAL_POLICY_JSON=
# M4父子/相邻证据扩展，空值或enabled=false保留原路径；真实dev收益未确认前不改默认。
# 示例字段enabled、max_chars(≤12000)、max_added(≤20)、radius(0..2)、max_seeds(≤20)。
EVIDENCE_EXPANSION_JSON=
# M4生成预算；空值默认context_window=32768、output_tokens=4096、reserve_tokens=256、max_chars=12000。
# context_window应按当前生成模型实际能力填写；未取得准确tokenizer时记录UTF-8字节保守估计。
ANSWER_BUDGET_JSON=

# 本机模型小批/缓存策略；默认查询缓存关闭，修改后重启API和模型宿主。
MODEL_RUNTIME_JSON=

# 条件HyDE/有限分解，默认均关闭；真实dev评估后再决定启用。
RETRIEVAL_ENHANCEMENT_JSON=

# M6服务端受控目录JSON，路径仅由维护者配置；目录项使用相对路径，不接受浏览器路径。
# API和模型宿主应指向同一份冻结catalog；空值关闭评测登记/执行，问答仍可用。
M6_EVALUATION_CATALOG=
# M6模型宿主持久结果目录，保留已完成题检查点，不指向课程原件/解析缓存目录。
M6_EVALUATION_WORK_DIR=
# 独立评测队列，不得与M2_QUEUE_NAME相同；Linux评测worker只消费该队列，并发固定1。
M6_QUEUE_NAME=knowledge-evaluation
